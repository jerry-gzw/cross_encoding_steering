{
  "output_dir": "outputs/normbank/base_mapping_audit",
  "subspace_dim": 1,
  "dataset": {
    "dataset_name": "normbank",
    "items_path": "outputs/prepared/normbank/ranked_endpoints.csv",
    "pair_id_column": "pair_id",
    "contrast_column": "pair_type",
    "split_column": "direction_split",
    "label_column": "label_name",
    "label_ranks": {
      "taboo": 0,
      "normal": 1,
      "expected": 2
    },
    "canonical_mapping": "canonical_taboo_normal_expected",
    "prompt_header": "You are classifying a behavior under a social-norm context.",
    "prompt_fields": [
      {
        "column": "text",
        "prefix": "Scenario: "
      }
    ],
    "question": "Question: In this context, how should the behavior be classified?",
    "answer_instruction": "Answer with only A, B, or C.",
    "extraction_filters": {
      "dataset": [
        "normbank"
      ]
    },
    "train_split": "train",
    "test_split": "test",
    "max_train_pairs_per_contrast": 2048,
    "max_test_pairs_per_contrast": 512
  },
