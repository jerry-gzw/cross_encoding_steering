{
  "output_dir": "outputs/published_caa",
  "protocol": {
    "reference_repo": "datasets/CAA",
    "behaviors": ["sycophancy", "hallucination", "refusal"],
    "normalization_behaviors": [
      "coordinate-other-ais",
      "corrigible-neutral-HHH",
      "hallucination",
      "myopic-reward",
      "survival-instinct",
      "sycophancy",
      "refusal"
    ],
    "interfaces": [
      "original_ab",
      "swapped_ab",
      "direct_answer_text",
      "opaque_codeword"
    ],
    "opaque_codewords": ["dax", "blicket"],
    "max_generation_items": 0,
    "max_interface_items": 50,
    "max_open_ended_items": 0
  },
  "runtime": {
    "batch_size": 4,
    "max_length": 2048,
    "max_new_tokens": 100,
    "seed": 13,
    "force_rerun": false,
    "continue_on_error": true
  },
  "judges": [
    {
      "alias": "gpt5_1_rubric_v3",
      "provider": "openai_compatible",
      "enabled": false,
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-5.1",
      "api_key_env": "OPENAI_API_KEY",
      "concurrency": 4,
      "timeout_seconds": 120,
      "max_retries": 5,
      "include_reason": true,
      "rubric_version": "caa_open_v3_calibrated",
      "output_filename": "published_caa_open_ended_judgments__gpt5_1_rubric_v3.csv"
    },
    {
      "alias": "claude_sonnet_4_6_rubric_v3",
      "provider": "anthropic",
      "enabled": false,
      "base_url": "https://api.anthropic.com",
      "model": "claude-sonnet-4-6",
      "api_key_env": "ANTHROPIC_API_KEY",
      "concurrency": 2,
      "timeout_seconds": 180,
      "max_retries": 5,
      "include_reason": true,
      "rubric_version": "caa_open_v3_calibrated",
      "output_filename": "published_caa_open_ended_judgments__claude_sonnet_4_6_rubric_v3.csv"
    },
    {
      "alias": "gemini_3_5_flash_rubric_v3_batch10",
      "provider": "gemini",
      "enabled": false,
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "model": "gemini-3.5-flash",
      "api_key_env": "GEMINI_API_KEY",
      "concurrency": 2,
      "request_batch_size": 10,
      "timeout_seconds": 180,
      "max_retries": 2,
      "include_reason": true,
      "thinking_level": "low",
      "rubric_version": "caa_open_v3_calibrated",
      "output_filename": "published_caa_open_ended_judgments__gemini_3_5_flash_rubric_v3_batch10.csv"
    }
  ],
  "models": [
    {
      "alias": "llama2_7b_chat",
      "name": "meta-llama/Llama-2-7b-chat-hf",
      "layer": 13,
      "interface_multipliers": [-1.0, 0.0, 1.0],
      "open_ended_multipliers": [-2.0, 0.0, 2.0],
      "enabled": true,
      "device_map": "auto",
      "torch_dtype": "float16"
    },
    {
      "alias": "llama2_13b_chat",
      "name": "meta-llama/Llama-2-13b-chat-hf",
      "layer": 14,
      "interface_multipliers": [-1.0, 0.0, 1.0],
      "open_ended_multipliers": [-2.0, 0.0, 2.0],
      "enabled": true,
      "device_map": "auto",
      "torch_dtype": "float16"
    }
  ]
}
